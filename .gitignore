# Secrets — never commit
#
# .robot-data holds identity.json: this robot's X25519 private key, which is what member
# apps seal space keys to. Committing it would hand anyone who clones the repo the ability
# to impersonate this robot and read every diary it belongs to. (Same reason pyunto-agent
# excludes .agent-data.)
.robot-data/
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Third-party robot models, fetched on demand by scripts/fetch_asimov.py. 45 MB of STL and
# someone else's file: a copy here would go stale silently, where a fetch names its upstream.
pyunto_robotics/assets/asimov/
pyunto_robotics/assets/meshes/

# Model weights (downloaded on demand, GBs)
models/
*.safetensors
*.gguf
*.pt
*.onnx

# Runtime artifacts
out/
output/
logs/
*.png
*.jpg
*.mp4
.token_cache.json

# macOS
.DS_Store
