# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# You probably do not need this file at all. Without it the robot creates an account of its
# own on first run and remembers it in ~/.pyunto-robot, which is what you want.

# Production server. The only setting most people ever change.
PYUNTO_BASE_URL=https://api.pyunto.com

# What the robot calls itself in the participant list.
PYUNTO_ROBOT_NAME=Robot

# ⚠️ DO NOT put your own Pyunto account here.
#
# A robot signed in as you cannot hear you. It ignores its own posts -- it has to, or it
# answers its own replies forever -- so every instruction you write would arrive as one of
# its own and be dropped. The robot looks connected and does nothing.
#
# These exist only for a robot with a registered account genuinely separate from the person
# using the diary, and that setup also needs PYUNTO_ROBOT_ACCOUNT=1 to confirm you mean it.
#
# PYUNTO_EMAIL=
# PYUNTO_PASSWORD=
# PYUNTO_ROBOT_ACCOUNT=1

# Optional: restrict the robot to a single chat space (UUID).
# If unset, the robot listens on every space it is a member of.
# PYUNTO_CHAT_SPACE_ID=
