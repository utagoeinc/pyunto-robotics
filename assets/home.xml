<!--
  A domestic laundry room for Momo.

  Layout (x = forward/north, y = left/west; the room is 5 x 4 m):

        y=+2 ┌──────────────────────────────────────────┐
             │  [WASHER]        [VANITY / COUNTER]      │
             │   drum            fold surface           │
             │                                          │
        y=0  │              (open floor)                │
             │                                          │
             │        [BASKET]                          │
        y=-2 └──────────────────────────────────────────┘
             x=-2.5                                  x=+2.5

  Everything is placed against Momo's measured reach, not guessed. With the arm chain in this
  model the right hand covers roughly 0.40 m in front of the base, between z=0.67 (reaching
  down) and z=1.40 (reaching up), shoulders at z=1.06. So:

    * The drum opening is centred at z=0.75 -- low, as a real front-loader is, and reachable
      by pitching the shoulder down rather than by crouching. Momo has no crouch.
    * The fold counter is at z=0.85, standard vanity height and near the middle of the reach
      band, which is why folding happens there rather than on the floor.
    * The basket rim is at z=0.32 so a towel can be dropped in from above without a crouch.

  The task the environment exists to support, in order:
    1. open the drum door        (a hinged disc, like the office doors but smaller)
    2. take a towel out          (grasp a cloth vertex, lift, carry)
    3. put it in the basket      (release above the rim)
    4. move it to the counter    (the "washstand space" that can hold laundry)
    5. fold it                   (see brain/laundry.py -- fold is grasp-two-corners-and-place)

  On the towels: these are real MuJoCo flex cloth (flexcomp), not boxes. That was a deliberate
  choice and it costs something -- measured 8.6k physics steps/s for a 9x7 sheet against
  81k for the rigid office scene -- but a folding demo with rigid "towels" would be a
  hinge animation, not folding. Grasping is by welding a cloth VERTEX to the palm, which is
  the same trick the office robot uses on door handles: friction alone will not hold cloth.
  Measured: welding a corner and lifting the hand to z=0.72 raises the sheet to z=0.665.

  Cloth vertices are addressable as bodies named `towel_a_0` ... `towel_a_62` (9x7 = 63 for
  each sheet). brain/laundry.py finds corners by index rather than by name lookup, because the
  grid order is deterministic: index = row * ncol + col.
-->
<mujoco model="pyunto_home">
  <include file="momo.xml"/>

  <statistic center="0 0 0.9" extent="4"/>

  <!--
    CG solver, not Newton. The office scene uses Newton, which is better for rigid contact,
    but a flex body adds a few hundred constrained DoF and Newton's exact factorisation gets
    expensive fast. timestep 0.004 rather than 0.005 because cloth edge constraints are stiff
    and go unstable at the larger step.
  -->
  <option timestep="0.004" iterations="40" solver="CG" tolerance="1e-7" cone="elliptic"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.45 0.45 0.45" specular="0.05 0.05 0.05"/>
    <rgba haze="0.85 0.88 0.92 1"/>
    <global azimuth="140" elevation="-22" offwidth="1600" offheight="1200"/>
    <map znear="0.02" zfar="40"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.88 0.91 0.95" rgb2="0.62 0.70 0.80"
             width="512" height="640"/>

    <!-- Floor: pale bathroom tile -->
    <texture name="tile_tex" type="2d" builtin="checker" rgb1="0.86 0.86 0.84"
             rgb2="0.80 0.80 0.78" width="512" height="512"/>
    <material name="tile" texture="tile_tex" texrepeat="10 8" texuniform="true"
              reflectance="0.05"/>

    <material name="wall_home"  rgba="0.94 0.93 0.90 1" specular="0.10"/>
    <material name="wall_tint"  rgba="0.86 0.91 0.94 1" specular="0.10"/>

    <!--
      The washer is white-grey with a DARK GLASS door and a blue trim ring. The ring is the
      colour cue ColorGrounder keys on: white appliance against a white wall is invisible to
      colour matching, which is exactly the failure the office whiteboard had.
    -->
    <material name="appliance" rgba="0.93 0.94 0.95 1" specular="0.45" shininess="0.55"/>
    <material name="drum_ring" rgba="0.20 0.45 0.80 1" specular="0.50" shininess="0.60"/>
    <material name="drum_glass" rgba="0.22 0.26 0.34 0.85" specular="0.85" shininess="0.90"/>
    <material name="drum_inner" rgba="0.55 0.58 0.62 1" specular="0.55" shininess="0.50"/>
    <material name="panel_mat" rgba="0.30 0.34 0.40 1" specular="0.40"/>

    <!-- The fold counter: warm wood top, so it is distinct from both floor and appliance. -->
    <material name="counter_top" rgba="0.72 0.55 0.38 1" specular="0.30" shininess="0.35"/>
    <material name="cabinet"     rgba="0.88 0.86 0.82 1" specular="0.20"/>
    <material name="basin"       rgba="0.97 0.97 0.98 1" specular="0.60" shininess="0.70"/>
    <material name="mirror"      rgba="0.72 0.80 0.86 1" specular="0.90" shininess="0.95"/>
    <material name="tap_mat"     rgba="0.78 0.80 0.83 1" specular="0.80" shininess="0.85"/>

    <!-- The basket is a saturated warm yellow: nothing else in the room is close to it. -->
    <material name="basket_mat" rgba="0.95 0.72 0.22 1" specular="0.25"/>

    <!-- Towels. Two colours so "the blue one" is a meaningful instruction. -->
    <material name="towel_a_mat" rgba="0.35 0.66 0.88 1" specular="0.10"/>
    <material name="towel_b_mat" rgba="0.96 0.72 0.78 1" specular="0.10"/>

    <material name="plant_home" rgba="0.28 0.55 0.32 1"/>
    <material name="pot_mat"    rgba="0.80 0.55 0.45 1"/>
  </asset>

  <default>
    <default class="h_wall">
      <geom type="box" condim="3" friction="0.8 0.05 0.01" material="wall_home" group="1"/>
    </default>
    <default class="h_fixture">
      <geom type="box" condim="3" friction="0.9 0.05 0.01" group="1"/>
    </default>
    <!--
      The drum door. Much lighter than an office door leaf (a washer door is a few hundred
      grams of glass and plastic) and with almost no spring, so it stays where it is put --
      a door that swings shut while the robot is reaching into the drum would make the task
      impossible for reasons that have nothing to do with laundry.
    -->
    <default class="h_drumdoor">
      <joint type="hinge" axis="0 0 1" damping="0.8" frictionloss="0.05" springref="0"
             stiffness="0.05" range="-2.4 0"/>
      <geom type="box" condim="3" density="180" friction="0.5 0.05 0.01" group="1"/>
    </default>
  </default>

  <worldbody>
    <light name="room_1" pos="-1.2 0 2.7" dir="0 0 -1" directional="false"
           diffuse="0.42 0.42 0.41" attenuation="1 0 0.05"/>
    <light name="room_2" pos="1.4 0 2.7" dir="0 0 -1" directional="false"
           diffuse="0.42 0.42 0.41" attenuation="1 0 0.05"/>
    <light name="window" pos="0 -4 2.4" dir="0 1 -0.55" directional="true"
           diffuse="0.30 0.30 0.32"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="tile"
          condim="6" friction="1.2 0.05 0.01"/>

    <camera name="overview" pos="0 -5.6 4.2" xyaxes="1 0 0 0 0.62 0.79"/>
    <camera name="washer_cam" pos="-1.4 -1.6 1.5" xyaxes="0.85 0.53 0 -0.20 0.32 0.93"/>
    <camera name="counter_cam" pos="1.5 -1.5 1.6" xyaxes="0.80 -0.60 0 0.24 0.32 0.92"/>

    <!-- =========================== SHELL =========================== -->
    <!-- 5 x 4 m room, 2.5 m walls -->
    <geom name="wall_n" class="h_wall" size="2.5 0.05 1.25" pos="0 2.0 1.25"/>
    <geom name="wall_s" class="h_wall" size="2.5 0.05 1.25" pos="0 -2.0 1.25"/>
    <geom name="wall_w" class="h_wall" size="0.05 2.0 1.25" pos="-2.5 0 1.25"/>
    <geom name="wall_e" class="h_wall" size="0.05 2.0 1.25" pos="2.5 0 1.25"/>
    <!-- a tinted splashback behind the fixtures, so the north wall is not featureless -->
    <geom name="splash" class="h_wall" size="2.4 0.02 0.45" pos="0 1.94 1.35"
          material="wall_tint"/>

    <!-- ====================== DRUM WASHING MACHINE ======================
         Body 0.62 wide x 0.62 deep x 0.85 tall, standing against the north wall at x=-1.45.
         The drum opening is centred at z=0.75, which is inside Momo's reach band (0.67-1.40).
    -->
    <geom name="washer_body" class="h_fixture" size="0.31 0.31 0.425" pos="-1.45 1.60 0.425"
          material="appliance"/>
    <geom name="washer_top" class="h_fixture" size="0.33 0.33 0.02" pos="-1.45 1.60 0.870"
          material="appliance"/>
    <!-- control panel: a dark strip along the top front, so the front face is identifiable -->
    <geom name="washer_panel" class="h_fixture" size="0.26 0.02 0.055" pos="-1.45 1.285 0.800"
          material="panel_mat"/>

    <!--
      The drum mouth. A ring of four boxes around a recess rather than a cylinder, because the
      opening has to be a HOLE the hand can enter: a cylinder geom is solid, and MuJoCo has no
      hollow primitive. The ring is the blue colour cue.
    -->
    <geom name="drum_ring_t" class="h_fixture" size="0.235 0.015 0.055" pos="-1.45 1.288 0.955"
          material="drum_ring"/>
    <geom name="drum_ring_b" class="h_fixture" size="0.235 0.015 0.055" pos="-1.45 1.288 0.545"
          material="drum_ring"/>
    <geom name="drum_ring_l" class="h_fixture" size="0.055 0.015 0.245" pos="-1.635 1.288 0.750"
          material="drum_ring"/>
    <geom name="drum_ring_r" class="h_fixture" size="0.055 0.015 0.245" pos="-1.265 1.288 0.750"
          material="drum_ring"/>
    <!-- The drum cavity: a back wall set 0.30 m in, so the hand has somewhere to reach INTO. -->
    <geom name="drum_back" class="h_fixture" size="0.20 0.02 0.20" pos="-1.45 1.62 0.750"
          material="drum_inner"/>
    <geom name="drum_floor" class="h_fixture" size="0.20 0.17 0.015" pos="-1.45 1.45 0.565"
          material="drum_inner"/>
    <geom name="drum_roof" class="h_fixture" size="0.20 0.17 0.015" pos="-1.45 1.45 0.935"
          material="drum_inner"/>
    <geom name="drum_side_l" class="h_fixture" size="0.015 0.17 0.20" pos="-1.66 1.45 0.750"
          material="drum_inner"/>
    <geom name="drum_side_r" class="h_fixture" size="0.015 0.17 0.20" pos="-1.24 1.45 0.750"
          material="drum_inner"/>

    <!--
      The door: hinged on its LEFT (-x) edge and swinging out toward the robot, which is how a
      front-loader opens. range -2.4..0 means it only ever opens outward; 0 is shut.
    -->
    <body name="drum_door" pos="-1.71 1.27 0.750">
      <joint name="washer_door" class="h_drumdoor"/>
      <geom name="drum_door_g" class="h_drumdoor" size="0.245 0.022 0.245" pos="0.245 0 0"
            material="drum_glass"/>
      <geom name="drum_door_rim" class="h_drumdoor" size="0.255 0.012 0.045" pos="0.245 0 0.255"
            material="drum_ring"/>
      <!-- Handle on the far edge from the hinge, at the same height as the opening centre. -->
      <geom name="drum_handle" type="capsule" fromto="0.475 -0.055 -0.08 0.475 -0.055 0.08"
            size="0.017" material="tap_mat"/>
      <site name="drum_handle_site" pos="0.475 -0.055 0" size="0.028" rgba="1 0.4 0 0.35"/>
    </body>

    <!-- ====================== VANITY / FOLD COUNTER ======================
         The "washstand space with room to put laundry down". Top at z=0.85, which is both
         standard vanity height and the middle of Momo's reach band. This is where folding
         happens; the surface is 1.3 x 0.55 m, big enough to lay a 0.40 x 0.30 towel flat.
    -->
    <geom name="cab_body" class="h_fixture" size="0.65 0.27 0.415" pos="1.20 1.62 0.415"
          material="cabinet"/>
    <geom name="counter_g" class="h_fixture" size="0.68 0.30 0.020" pos="1.20 1.62 0.850"
          material="counter_top"/>
    <!-- a shallow basin at the far end, so the counter reads as a washstand -->
    <geom name="basin_g" class="h_fixture" size="0.19 0.16 0.055" pos="1.72 1.62 0.905"
          material="basin"/>
    <geom name="tap_g" type="cylinder" size="0.018 0.10" pos="1.72 1.80 0.960"
          material="tap_mat" group="1"/>
    <geom name="mirror_g" class="h_fixture" size="0.42 0.015 0.32" pos="1.55 1.93 1.55"
          material="mirror"/>

    <!-- ============================ BASKET ============================
         Four walls and a floor, open at the top: a towel is dropped IN, so it cannot be a
         solid box. Rim at z=0.32, low enough to drop into without crouching.
    -->
    <body name="basket" pos="-0.30 -0.55 0">
      <geom name="basket_floor" class="h_fixture" size="0.26 0.20 0.015" pos="0 0 0.015"
            material="basket_mat"/>
      <geom name="basket_w1" class="h_fixture" size="0.26 0.016 0.155" pos="0 0.19 0.165"
            material="basket_mat"/>
      <geom name="basket_w2" class="h_fixture" size="0.26 0.016 0.155" pos="0 -0.19 0.165"
            material="basket_mat"/>
      <geom name="basket_w3" class="h_fixture" size="0.016 0.20 0.155" pos="0.25 0 0.165"
            material="basket_mat"/>
      <geom name="basket_w4" class="h_fixture" size="0.016 0.20 0.155" pos="-0.25 0 0.165"
            material="basket_mat"/>
      <site name="basket_site" pos="0 0 0.36" size="0.04" rgba="1 0.8 0.2 0.35"/>
    </body>

    <!-- a little greenery, purely so the room does not look like a lab -->
    <geom name="pot" type="cylinder" size="0.13 0.16" pos="2.15 -1.55 0.16"
          material="pot_mat" group="1"/>
    <geom name="plant_home_g" type="ellipsoid" size="0.20 0.20 0.24" pos="2.15 -1.55 0.48"
          material="plant_home" group="1"/>

    <!-- ============================= TOWELS =============================
         Real cloth. 9 x 7 vertices at 0.05 m spacing = a 0.40 x 0.30 m sheet, which is a hand
         towel and is what fits both the drum and the counter.

         `towel_a` starts INSIDE the drum (that is the task: take it out). `towel_b` starts on
         the counter, so folding can be exercised without first doing the retrieval.

         radius 0.004 is the collision thickness of the cloth. Bigger is more stable but the
         sheet stops looking like fabric; smaller and the gripper passes through it.

         selfcollide="none" is a real simplification: a folded towel will pass through itself.
         Enabling it costs roughly 3x and mattered less than having the rest of the task work.
    -->
    <flexcomp name="towel_a" type="grid" count="9 7 1" spacing="0.05 0.05 0.05"
              pos="-1.45 1.45 0.60" dim="2" mass="0.25" radius="0.004"
              material="towel_a_mat">
      <edge equality="true" solref="0.005 1"/>
      <contact condim="3" solref="0.005 1" selfcollide="none"/>
    </flexcomp>

    <flexcomp name="towel_b" type="grid" count="9 7 1" spacing="0.05 0.05 0.05"
              pos="1.05 1.60 0.90" dim="2" mass="0.25" radius="0.004"
              material="towel_b_mat">
      <edge equality="true" solref="0.005 1"/>
      <contact condim="3" solref="0.005 1" selfcollide="none"/>
    </flexcomp>
  </worldbody>

  <!--
    Grasp welds, inactive until a hand closes on something.

    Cloth needs one weld per hand per towel: folding is a two-handed action (pick up two
    corners, carry them across to the far edge) and a single weld can only ever hold one
    corner. The office robot needed only one because a door has one handle.

    body2 is set to vertex 0 of each sheet as a placeholder -- Skills rewrites eq_obj2id at the
    moment of contact to whichever vertex is actually nearest the palm, then writes the relative
    pose into eq_data. Without rewriting the pose the solver enforces the compiled offset and
    the towel snaps across the room.
  -->
  <equality>
    <weld name="grasp_a_r" body1="palm_r" body2="towel_a_0" active="false" solref="0.01 1"/>
    <weld name="grasp_a_l" body1="palm_l" body2="towel_a_0" active="false" solref="0.01 1"/>
    <weld name="grasp_b_r" body1="palm_r" body2="towel_b_0" active="false" solref="0.01 1"/>
    <weld name="grasp_b_l" body1="palm_l" body2="towel_b_0" active="false" solref="0.01 1"/>
  </equality>

  <keyframe>
    <!--
      qpos = momo (34) + washer_door (1) + towel_a (63 verts x 3) + towel_b (63 x 3).

      Flex vertices are NOT listed here: MuJoCo fills them from the flexcomp's own `pos`, and
      writing 378 coordinates into a keyframe by hand would be both unreadable and wrong the
      moment the grid size changed. A keyframe that omits them leaves them at their compiled
      positions, which is exactly what is wanted.

      "start" puts Momo in the middle of the room facing the washer (+y, i.e. north). Her
      forward axis is +x, so the quaternion (0.7071,0,0,0.7071) is +90 degrees about z, which
      maps +x onto +y -- the same convention as the office scene.
    -->
    <key name="start"
         qpos="-1.45 0.15 0.7659   0.7071 0 0 0.7071
               0
               0 0
               -0.05 -0.20 0 -0.22   0 0
               -0.05  0.20 0 -0.22   0 0
               0 0 -0.25 0.5 -0.25 0
               0 0 -0.25 0.5 -0.25 0
               0"/>
    <!-- "middle" starts her in the centre of the room, for navigation runs. -->
    <key name="middle"
         qpos="0 -0.60 0.7659   0.7071 0 0 0.7071
               0
               0 0
               -0.05 -0.20 0 -0.22   0 0
               -0.05  0.20 0 -0.22   0 0
               0 0 -0.25 0.5 -0.25 0
               0 0 -0.25 0.5 -0.25 0
               0"/>
    <!-- "counter" starts her at the fold surface, for folding runs. -->
    <key name="counter"
         qpos="1.05 1.05 0.7659   0.7071 0 0 0.7071
               0
               0 0
               -0.05 -0.20 0 -0.22   0 0
               -0.05  0.20 0 -0.22   0 0
               0 0 -0.25 0.5 -0.25 0
               0 0 -0.25 0.5 -0.25 0
               0"/>
  </keyframe>
</mujoco>
