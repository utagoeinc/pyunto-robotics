<!--
  A one-bedroom flat with an older person living in it, and sensors that notice.

  This is the demonstration where nothing is a robot. There is no machine to command: the
  house watches, and what it sees goes into a diary that a daughter in another city reads.
  That is a different product from "tell the robot to do something", and it is the one that
  fits a diary best -- the record IS the point, not a side effect of an errand.

  The person is a body on slide joints, driven by a scripted day rather than by physics
  alone: they get up, cross to the kitchen, sit a long while, visit the bathroom, go back to
  bed. Modelling them as something that moves through the rooms -- rather than as a state
  machine printing "in kitchen" -- is what makes the sensors real. A motion sensor fires
  because a body entered its volume, and the bed sensor reads a load because someone is on
  the bed. Change the routine and the readings change with it, which is the only way to tell
  whether the detection logic works.

  Rooms, west to east: bedroom, hallway with the bathroom off it, then the living room and
  the kitchen at the east end. Doors are open; an older person's flat is laid out for that.
  Sensor volumes are the geoms named `pir_*`; they are visual markers, and the code asks
  where the person's body is rather than relying on contacts, because a PIR sensor watches a
  volume it never touches.
-->
<mujoco model="watch">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.48 0.47 0.46" diffuse="0.40 0.40 0.39" specular="0.05 0.05 0.05"/>
    <map znear="0.02" zfar="60"/>
    <quality shadowsize="4096"/>
    <global offwidth="1600" offheight="1200"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.55 0.62 0.72" rgb2="0.86 0.88 0.90" width="256" height="256"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.72 0.66 0.58"
             rgb2="0.68 0.62 0.54" width="256" height="256"/>
    <material name="floor" texture="floor_tex" texrepeat="10 8" specular="0.05"/>
    <material name="wall" rgba="0.92 0.90 0.86 1" specular="0.04"/>
    <material name="inner_wall" rgba="0.88 0.86 0.83 1" specular="0.04"/>

    <!-- Furniture, muted so the person and the sensors are what the eye goes to. -->
    <material name="bed_mat" rgba="0.93 0.89 0.80 1" specular="0.05"/>
    <material name="wood" rgba="0.52 0.40 0.28 1" specular="0.12"/>
    <material name="appliance" rgba="0.80 0.81 0.83 1" specular="0.45" shininess="0.5"/>
    <material name="porcelain" rgba="0.95 0.95 0.94 1" specular="0.5" shininess="0.6"/>
    <!-- A little warmer than the mattress, so the head end of the bed is legible. -->
    <material name="pillow_mat" rgba="0.97 0.94 0.88 1" specular="0.2"/>

    <!-- The person. One warm colour so they are unmistakable in a grey flat. -->
    <material name="person_body" rgba="0.88 0.42 0.30 1" specular="0.15"/>
    <material name="person_head" rgba="0.90 0.76 0.65 1" specular="0.15"/>
    <material name="person_hair" rgba="0.88 0.88 0.86 1" specular="0.10"/>
    <material name="person_skin" rgba="0.90 0.76 0.65 1" specular="0.15"/>
    <!--
      Trousers: a muted blue that belongs with the orange top rather than fighting it.

      This colour has been wrong twice. Blue-grey vanished against the bed, and the dark
      green that replaced it went too far the other way -- lying down, an orange torso and two
      dark green sticks read as separate objects rather than as one person's legs, which is
      why they still looked detached after the geometry was measured flat. Clothing colours
      that sit near each other in tone keep a figure reading as a figure.
    -->
    <material name="person_legs" rgba="0.31 0.38 0.60 1" specular="0.10"/>

    <!--
      Sensor volumes, translucent. They are drawn because a demonstration of watching should
      show what is being watched; an invisible sensor teaches nobody anything. Each lights up
      in the viewer when it fires (the skill swaps the material).
    -->
    <material name="pir_idle" rgba="0.35 0.62 0.88 0.30"/>
    <material name="pir_fired" rgba="1.00 0.70 0.10 0.85" emission="0.6"/>
    <material name="lamp_off" rgba="0.35 0.35 0.36 1" specular="0.2"/>

    <!--
      The wall clock. Segments are emissive when lit so they read as a display rather than
      as painted-on shapes, and nearly black when off -- a real seven-segment panel shows its
      dark segments too, and hiding them entirely makes the digits float.
    -->
    <material name="clock_case" rgba="0.12 0.12 0.14 1" specular="0.3"/>
    <material name="seg_off" rgba="0.26 0.27 0.30 1"/>
    <material name="seg_on" rgba="1.00 0.45 0.12 1" emission="0.25"/>
    <material name="speed_off" rgba="0.22 0.24 0.26 1"/>
    <material name="speed_on" rgba="0.34 0.88 0.48 1" emission="0.5"/>
    <material name="lamp_on" rgba="1.0 0.93 0.62 1" emission="0.95" specular="0.4"/>
  </asset>

  <worldbody>
    <light name="ceiling" pos="3 1.5 3.4" dir="0 0 -1" directional="true"
           diffuse="0.68 0.67 0.64" specular="0.08 0.08 0.08" castshadow="true"/>
    <light name="fill" pos="-2 -4 3" dir="0.4 0.6 -0.7" directional="true"
           diffuse="0.20 0.20 0.22"/>

    <geom name="floor" type="plane" size="20 20 0.05" material="floor"
          friction="1.0 0.02 0.001" condim="3"/>

    <!-- ===== outer walls ===== -->
    <geom name="wall_n" type="box" pos="3.0 3.6 1.3" size="6.2 0.12 1.3" material="wall"/>
    <geom name="wall_s" type="box" pos="3.0 -3.6 1.3" size="6.2 0.12 1.3" material="wall"/>
    <geom name="wall_w" type="box" pos="-3.1 0 1.3" size="0.12 3.6 1.3" material="wall"/>
    <geom name="wall_e" type="box" pos="9.1 0 1.3" size="0.12 3.6 1.3" material="wall"/>

    <!-- ===== inner walls, leaving doorways ===== -->
    <!-- bedroom / hallway divider, doorway at the south end -->
    <geom name="div_bed" type="box" pos="0.0 1.9 1.3" size="0.10 1.7 1.3" material="inner_wall"/>
    <!-- bathroom, a small room off the hallway -->
    <geom name="bath_n" type="box" pos="2.4 1.5 1.3" size="1.3 0.10 1.3" material="inner_wall"/>
    <geom name="bath_e" type="box" pos="3.6 2.6 1.3" size="0.10 1.2 1.3" material="inner_wall"/>
    <!-- living / kitchen divider, doorway at the north end -->
    <geom name="div_kitchen" type="box" pos="6.2 -2.0 1.3" size="0.10 1.6 1.3" material="inner_wall"/>

    <!-- ===== bedroom (west) ===== -->
    <body name="bed" pos="-1.6 1.6 0">
      <geom name="bed_frame" type="box" pos="0 0 0.22" size="1.0 0.75 0.22" material="wood"/>
      <geom name="bed_mattress" type="box" pos="0 0 0.52" size="0.95 0.70 0.10" material="bed_mat"/>
      <geom name="bed_pillow" type="box" pos="-0.70 0 0.66" size="0.22 0.32 0.06" material="pillow_mat"/>
    </body>
    <geom name="bedside_lamp" type="box" pos="-0.3 1.6 0.55" size="0.10 0.10 0.18"
          material="lamp_off"/>

    <!-- ===== bathroom ===== -->
    <geom name="toilet" type="box" pos="2.4 2.6 0.25" size="0.24 0.32 0.25" material="porcelain"/>
    <geom name="basin" type="box" pos="1.4 2.9 0.45" size="0.28 0.20 0.10" material="porcelain"/>

    <!-- ===== living room ===== -->
    <body name="sofa" pos="4.4 -1.8 0">
      <geom name="sofa_seat" type="box" pos="0 0 0.25" size="0.95 0.45 0.12" material="bed_mat"/>
      <geom name="sofa_back" type="box" pos="0 -0.38 0.55" size="0.95 0.10 0.30" material="bed_mat"/>
    </body>
    <geom name="tv" type="box" pos="4.4 1.0 0.85" size="0.55 0.06 0.35" material="appliance"/>
    <geom name="living_lamp" type="box" pos="6.0 0.9 0.60" size="0.10 0.10 0.20"
          material="lamp_off"/>

    <!-- ===== kitchen (east) ===== -->
    <geom name="counter" type="box" pos="7.8 1.6 0.45" size="1.1 0.35 0.45" material="wood"/>
    <geom name="fridge" type="box" pos="8.6 -1.0 0.85" size="0.35 0.35 0.85" material="appliance"/>
    <geom name="kettle" type="box" pos="7.4 1.6 1.00" size="0.10 0.10 0.10" material="appliance"/>
    <geom name="kitchen_lamp" type="box" pos="7.8 0.6 0.60" size="0.10 0.10 0.20"
          material="lamp_off"/>

    <!--
      ===== sensor volumes =====
      One per room, sized to the room and sitting at body height. The code tests whether the
      person's centre is inside these boxes, which is what a PIR sensor's cone amounts to and
      is far more robust than counting contacts with furniture.
    -->
    <!--
      Flat pads on the floor, not boxes filling the room.

      As full-height volumes they were translucent sheets laid over the whole flat, and
      looking down through five of them at once made the furniture and the person hard to
      see -- the very thing the window is for. A pad lights up just as clearly and hides
      nothing.

      The sensors still read the room as a volume: the code tests the person's position
      against `pir_*` half-sizes, and those are set below to the room rather than to the pad.
    -->
    <geom name="pir_bedroom" type="box" pos="-1.5 1.4 0.012" size="1.4 2.0 0.012"
          material="pir_idle" contype="0" conaffinity="0"/>
    <geom name="pir_bathroom" type="box" pos="2.4 2.6 0.012" size="1.2 0.9 0.012"
          material="pir_idle" contype="0" conaffinity="0"/>
    <geom name="pir_living" type="box" pos="4.3 -0.8 0.012" size="2.0 2.6 0.012"
          material="pir_idle" contype="0" conaffinity="0"/>
    <geom name="pir_kitchen" type="box" pos="7.9 0.4 0.012" size="1.1 3.0 0.012"
          material="pir_idle" contype="0" conaffinity="0"/>
    <geom name="pir_hallway" type="box" pos="1.2 -1.4 0.012" size="1.2 2.0 0.012"
          material="pir_idle" contype="0" conaffinity="0"/>


    <!--
      ===== the wall clock =====

      A demonstration that compresses a day into a few minutes has to say so, or the viewer
      cannot tell a quiet afternoon from a frozen simulation. The panel shows her time of day
      and how fast it is running.

      Seven-segment digits made of geoms, switched by swapping materials. There is no text in
      MuJoCo, and a clock that needs an overlay is a clock that does not appear in a
      screenshot or a recording -- which is where this demonstration mostly lives.

      On the hallway wall, high and facing into the flat, so it is in shot from the overhead
      view the scene opens with.
    -->
    <!--
      ===== the clock, laid flat on the hallway floor =====
      A wall clock faces one way and the camera looks down on this flat, so a wall clock is
      invisible from the view the demo opens with. Laid on the floor the time is readable
      from any angle a viewer picks. Digits are 0.7m tall -- legible from the 11m opening
      view without zooming in.

      Laid out in plain reading order: for this camera world +x runs rightwards on screen,
      so no mirroring is wanted. (Both mirroring the digit slots and mirroring the glyph
      strokes were tried; each writes the time backwards.)
    -->
    <body name="clock" pos="-0.30 -2.15 0.0">
      <geom name="clock_case" type="box" pos="0.79 0 0.030" size="1.50 0.95 0.010"
            material="clock_case" contype="0" conaffinity="0"/>
      <geom name="clock_d0_a" type="box" pos="0.0 0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_b" type="box" pos="0.1904 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_c" type="box" pos="0.1904 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_d" type="box" pos="0.0 -0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_e" type="box" pos="-0.1904 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_f" type="box" pos="-0.1904 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d0_g" type="box" pos="0.0 0.0 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_a" type="box" pos="0.459 0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_b" type="box" pos="0.6494 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_c" type="box" pos="0.6494 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_d" type="box" pos="0.459 -0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_e" type="box" pos="0.2686 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_f" type="box" pos="0.2686 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d1_g" type="box" pos="0.459 0.0 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_a" type="box" pos="1.122 0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_b" type="box" pos="1.3124 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_c" type="box" pos="1.3124 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_d" type="box" pos="1.122 -0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_e" type="box" pos="0.9316 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_f" type="box" pos="0.9316 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d2_g" type="box" pos="1.122 0.0 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_a" type="box" pos="1.581 0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_b" type="box" pos="1.7714 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_c" type="box" pos="1.7714 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_d" type="box" pos="1.581 -0.357 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_e" type="box" pos="1.3906 -0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_f" type="box" pos="1.3906 0.1802 0.065" size="0.0306 0.153 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <geom name="clock_d3_g" type="box" pos="1.581 0.0 0.065" size="0.1768 0.0306 0.035" material="seg_off" contype="0" conaffinity="0"/>
      <!-- The colon between hours and minutes. Always lit; a blinking one would be
           read as a fault in a still image. -->
      <geom name="clock_colon_top" type="box" pos="0.7905 0.119 0.065" size="0.0306 0.0306 0.035" material="seg_on" contype="0" conaffinity="0"/>
      <geom name="clock_colon_bot" type="box" pos="0.7905 -0.119 0.065" size="0.0306 0.0306 0.035" material="seg_on" contype="0" conaffinity="0"/>

      <!--
        Speed, as a row of five pips: one lit is slow, five is fast. A number would need
        more digits and would be read less quickly than a bar, and the question a viewer
        has is "is this running, and roughly how fast", not the exact multiplier.
      -->
      <geom name="speed_1" type="box" pos="0.34 0.62 0.065" size="0.0952 0.0476 0.035" material="speed_off" contype="0" conaffinity="0"/>
      <geom name="speed_2" type="box" pos="0.595 0.62 0.065" size="0.0952 0.0476 0.035" material="speed_off" contype="0" conaffinity="0"/>
      <geom name="speed_3" type="box" pos="0.85 0.62 0.065" size="0.0952 0.0476 0.035" material="speed_off" contype="0" conaffinity="0"/>
      <geom name="speed_4" type="box" pos="1.105 0.62 0.065" size="0.0952 0.0476 0.035" material="speed_off" contype="0" conaffinity="0"/>
      <geom name="speed_5" type="box" pos="1.36 0.62 0.065" size="0.0952 0.0476 0.035" material="speed_off" contype="0" conaffinity="0"/>
    </body>

    <!--
      ===== the person =====
      Slide joints in x and y and a hinge for facing, driven by position actuators. Not a
      humanoid: legs would be a locomotion problem, and this scene is not about locomotion.
      What matters is that a body with a real position moves through real rooms, so the
      sensors are reading something rather than being told what to say.
    -->
    <!--
      The body's frame sits at the origin, not at the bed.

      Placed at the bed, the slide joints measured from there: commanding x=7.8 for the
      kitchen put the person at 6.2, and every sensor test missed. A joint that moves a body
      is measured from wherever that body was declared, so declaring it at the origin makes
      the joint values world coordinates -- which is what the skills reason in.

      Height 0.82 puts the soles on the floor when person_z is 0. It was 0.95, sized for the
      old capsule, and the taller figure then stood with its feet 0.16 m in the air.
    -->
    <body name="person" pos="0 0 0.82">
      <joint name="person_x" type="slide" axis="1 0 0" range="-3.0 9.0" damping="40"/>
      <joint name="person_y" type="slide" axis="0 1 0" range="-3.5 3.5" damping="40"/>
      <joint name="person_z" type="slide" axis="0 0 1" range="-0.45 0.9" damping="40"/>
      <!--
        Declared inertia, because every geom now hangs off the child body below and MuJoCo
        refuses a moving body with no mass of its own. 55 kg is an older woman; the figure
        never collides with anything, so this only has to be plausible and non-zero.
      -->
      <inertial pos="0 0 0" mass="55" diaginertia="6 6 2"/>
      <!--
        A figure, not a capsule with a ball on top.

        Sizes are an older woman's: about 1.55 m standing, narrow shoulders, a slight stoop.
        None of it is load-bearing -- every geom is contype/conaffinity 0, so the body passes
        through furniture and the sensors read position rather than contact -- so this is
        purely so that a person watching the window sees a person.

        The whole figure hangs from `person_pitch` below, which tips it flat for lying down.
        That is why the parts are positioned relative to the hips rather than to the floor:
        rotating the parent then carries all of them together.
      -->
      <body name="person_body_frame" pos="0 0 0">
        <joint name="person_pitch" type="hinge" axis="0 1 0" range="-1.6 0.2" damping="30"/>

        <!-- Torso, with a slight forward lean at the shoulders. -->
        <geom name="person_torso" type="capsule" fromto="0 0 -0.18 0.02 0 0.20" size="0.115"
              material="person_body" density="200" contype="0" conaffinity="0"/>
        <geom name="person_hips" type="capsule" fromto="0 -0.07 -0.22 0 0.07 -0.22" size="0.10"
              material="person_body" density="200" contype="0" conaffinity="0"/>

        <!-- Head and neck. -->
        <geom name="person_neck" type="capsule" fromto="0.02 0 0.20 0.03 0 0.27" size="0.045"
              material="person_head" density="200" contype="0" conaffinity="0"/>
        <geom name="person_head_g" type="sphere" pos="0.035 0 0.36" size="0.095"
              material="person_head" density="200" contype="0" conaffinity="0"/>
        <!-- Grey hair, which reads as age at a glance and from any angle. -->
        <geom name="person_hair" type="sphere" pos="0.03 0 0.395" size="0.088"
              material="person_hair" density="10" contype="0" conaffinity="0"/>

        <!-- Arms, hanging with a slight bend at the elbow. -->
        <geom name="person_arm_l" type="capsule" fromto="0.01 0.13 0.14 0.03 0.15 -0.10"
              size="0.042" material="person_body" density="150"
              contype="0" conaffinity="0"/>
        <geom name="person_forearm_l" type="capsule" fromto="0.03 0.15 -0.10 0.07 0.14 -0.30"
              size="0.037" material="person_skin" density="150"
              contype="0" conaffinity="0"/>
        <geom name="person_arm_r" type="capsule" fromto="0.01 -0.13 0.14 0.03 -0.15 -0.10"
              size="0.042" material="person_body" density="150"
              contype="0" conaffinity="0"/>
        <geom name="person_forearm_r" type="capsule" fromto="0.03 -0.15 -0.10 0.07 -0.14 -0.30"
              size="0.037" material="person_skin" density="150"
              contype="0" conaffinity="0"/>

        <!-- Legs. -->
        <geom name="person_thigh_l" type="capsule" fromto="0 0.07 -0.26 0 0.07 -0.52"
              size="0.055" material="person_legs" density="180"
              contype="0" conaffinity="0"/>
        <geom name="person_shin_l" type="capsule" fromto="0 0.07 -0.52 0 0.06 -0.76"
              size="0.045" material="person_legs" density="180"
              contype="0" conaffinity="0"/>
        <geom name="person_thigh_r" type="capsule" fromto="0 -0.07 -0.26 0 -0.07 -0.52"
              size="0.055" material="person_legs" density="180"
              contype="0" conaffinity="0"/>
        <geom name="person_shin_r" type="capsule" fromto="0 -0.07 -0.52 0 -0.06 -0.76"
              size="0.045" material="person_legs" density="180"
              contype="0" conaffinity="0"/>
        <geom name="person_foot_l" type="box" pos="0.05 0.06 -0.79" size="0.09 0.04 0.03"
              material="person_legs" density="180" contype="0" conaffinity="0"/>
        <geom name="person_foot_r" type="box" pos="0.05 -0.06 -0.79" size="0.09 0.04 0.03"
              material="person_legs" density="180" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="person_x" joint="person_x" kp="4000" ctrlrange="-3.0 9.0" forcerange="-2000 2000"/>
    <position name="person_y" joint="person_y" kp="4000" ctrlrange="-3.5 3.5" forcerange="-2000 2000"/>
    <!-- Height: 0 is standing, -0.45 is lying down or sitting. The bed and chair sensors
         read this, which is how "in bed" is told from "standing beside the bed". -->
    <!--
      kp 40000, forcerange 4000. A position servo's steady-state error is load over gain, and
      at kp=900 a 55 kg figure sagged the full 0.45 m of the joint's travel: commanded to
      stand it sat at the bottom stop with its feet through the floor. The figure is heavier
      than the capsule it replaced, so the gain had to follow.
    -->
    <position name="person_z" joint="person_z" kp="40000" ctrlrange="-0.45 0.9"
              forcerange="-4000 4000"/>
    <!--
      Tips the whole figure flat. Standing is 0; -1.5 rad is lying on the bed or reclining on
      the sofa. Without this she sank into the mattress in an upright posture, which reads as
      a person standing in a hole rather than a person asleep -- and "is she in bed" is the
      single most important thing this scene has to show.
    -->
    <position name="person_pitch" joint="person_pitch" kp="600" ctrlrange="-1.6 0.2"
              forcerange="-600 600"/>
  </actuator>

  <keyframe>
    <!-- qpos = person only (3): x, y, z. Asleep in bed at the start of the day. -->
    <key name="asleep" qpos="-1.6 1.6 -0.20 -1.5"/>
    <key name="up" qpos="-1.6 0.4 0 0"/>
  </keyframe>
</mujoco>
