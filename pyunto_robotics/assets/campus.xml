<!--
  An outdoor site for the Q1 patrol robot: one building, the ground around it, and the things
  that make walking outside different from walking on an office floor.

  Layout, 30 x 24 m, seen from above (x east, y north):

        y=+12 ┌────────────────────────────────────────────────┐
              │  hedge      trees        trees        hedge     │
              │      ┌────────────────────────────┐            │
              │      │                            │            │
              │  W3  │        BUILDING            │  W2        │   <- waypoints are the
              │      │   14 x 10 m, 7 m tall      │            │      four corners of the
              │      │                            │            │      patrol loop
              │      └───────────┬────────────────┘            │
              │        STEPS ────┘  (3 x 0.16 m rises)         │
              │  W4                                    W1      │
        y=-12 └────────────────────────────────────────────────┘
              x=-15                                        x=+15

  What each feature is here to exercise, since none of it is scenery:

  * **The building** is the thing being patrolled. Its walls are the obstacle the robot has to
    hold a distance from, and its corners are what "go round the building" means. The facade
    carries a bright entrance and windows so a camera can tell one side from another -- with
    four identical grey walls, "which side am I on" has no visual answer.

  * **Stairs** at the entrance, three 0.16 m rises. This is the reason the patrol robot has
    four legs. 0.16 m against a 0.325 m standing leg is a real step, not a ramp in disguise.

  * **Grass** is a separate ground patch with LOWER friction than the paving (0.7 against 1.2)
    and slight unevenness from a heightfield. A patrol that only ever crosses flat concrete
    does not test anything the office floor did not.

  * **Trees and hedges** are obstacles with gaps between them, so there is something to route
    around that is not a wall. They are also the only tall green things in the scene, which
    makes them findable by colour.

  * **A slope** on the west side, about 7 degrees, because the trunk controller holds height
    relative to the ground under the feet and that needs somewhere to be tested.

  The terrain is a procedural heightfield: the data is generated in Python at load time by
  sim/terrain.py, not loaded from a file, so nothing here depends on an external asset.
-->
<mujoco model="pyunto_campus">
  <include file="pyunto_q1.xml"/>

  <statistic center="0 0 3" extent="20"/>

  <option timestep="0.004" iterations="30" solver="Newton" cone="elliptic"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.44" ambient="0.42 0.44 0.46" specular="0.1 0.1 0.1"/>
    <rgba haze="0.72 0.80 0.88 1"/>
    <global azimuth="130" elevation="-20" offwidth="1600" offheight="1200"/>
    <map znear="0.05" zfar="120"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.72 0.92" rgb2="0.86 0.90 0.95"
             width="512" height="640"/>

    <!--
      The heightfield the lawn sits on. nrow/ncol are modest on purpose: 64 x 64 over 24 m is
      a 0.38 m cell, which is finer than the robot's foot spacing and costs almost nothing
      (measured 155k physics steps/s on a hfield scene). The elevation data is written from
      Python -- see sim/terrain.py -- so this declaration only reserves the space.
    -->
    <!--
      The 4th size component is the thickness of the solid base UNDER the field, and it shows:
      at 0.1 m the lawn rendered as a slab sitting proud of the paving with visible cliff
      edges all round. 0.02 keeps the base thin enough to read as ground rather than as a
      plinth, and the 3rd component (0.30) is the total elevation range, kept modest so the
      grass is uneven rather than hilly.
    -->
    <hfield name="lawn_hf" nrow="64" ncol="64" size="12 10 0.30 0.02"/>

    <texture name="paving_tex" type="2d" builtin="checker" rgb1="0.58 0.58 0.56"
             rgb2="0.63 0.63 0.61" width="512" height="512"/>
    <material name="paving" texture="paving_tex" texrepeat="30 24" texuniform="true"
              reflectance="0.02"/>

    <material name="grass"     rgba="0.32 0.52 0.26 1" specular="0.05"/>
    <material name="concrete"  rgba="0.68 0.68 0.66 1" specular="0.10"/>
    <material name="wall_bldg" rgba="0.80 0.78 0.74 1" specular="0.15"/>
    <material name="wall_east" rgba="0.74 0.72 0.70 1" specular="0.15"/>
    <material name="roof"      rgba="0.35 0.36 0.40 1" specular="0.20"/>
    <material name="glass"     rgba="0.35 0.55 0.70 0.75" specular="0.85" shininess="0.90"/>
    <material name="entrance"  rgba="0.90 0.45 0.15 1" specular="0.30"/>
    <material name="trunk_mat" rgba="0.36 0.26 0.18 1"/>
    <material name="leaf_mat"  rgba="0.18 0.45 0.20 1"/>
    <material name="hedge_mat" rgba="0.22 0.42 0.22 1"/>
    <material name="step_mat"  rgba="0.72 0.71 0.68 1" specular="0.12"/>
    <material name="marker"    rgba="0.95 0.80 0.10 1" specular="0.30"/>
    <material name="bollard"   rgba="0.85 0.30 0.15 1" specular="0.30"/>
  </asset>

  <default>
    <default class="c_wall">
      <geom type="box" condim="3" friction="0.9 0.05 0.01" material="wall_bldg" group="1"/>
    </default>
    <default class="c_prop">
      <geom type="box" condim="3" friction="0.9 0.05 0.01" group="1"/>
    </default>
    <!--
      Steps get high friction and condim=4. A foot landing on a step edge with only three
      contact dimensions slides off it, which reads as the robot failing to climb when the
      real problem is that the stair has no grip.
    -->
    <default class="c_step">
      <geom type="box" condim="4" friction="1.4 0.1 0.02" material="step_mat" group="1"/>
    </default>
  </default>

  <worldbody>
    <!-- Sun low in the west, so the building casts a long shadow and surfaces differ. -->
    <light name="sun" pos="-14 -8 16" dir="0.65 0.4 -1" directional="true"
           diffuse="0.62 0.60 0.55" specular="0.15 0.15 0.15" castshadow="true"/>
    <light name="sky" pos="0 0 20" dir="0 0 -1" directional="true" diffuse="0.24 0.26 0.30"/>

    <!--
      Paving: the flat, high-friction ground the patrol route runs on. It is the world's base
      plane, and the lawn sits on top of it as a separate patch.
    -->
    <geom name="ground" type="plane" size="0 0 0.05" material="paving"
          condim="6" friction="1.2 0.05 0.01"/>

    <!--
      The lawn. A heightfield, so it is gently uneven, and with LOWER friction than paving --
      0.7 against 1.2. Walking across grass is the part of an outdoor patrol that a flat
      office floor cannot stand in for.
    -->
    <!--
      Sunk so its mean level sits just below the paving: the robot walks off concrete onto
      grass without a step up. The offset is -0.20 against a 0.30 m range, so the low parts of
      the lawn are slightly below the paving and the high parts slightly above, which is what
      grass beside a path actually does.
    -->
    <geom name="lawn" type="hfield" hfield="lawn_hf" pos="0 0 -0.20"
          material="grass" condim="4" friction="0.7 0.05 0.01"/>

    <camera name="overview" pos="0 -26 18" xyaxes="1 0 0 0 0.62 0.79"/>
    <camera name="entrance_cam" pos="0 -13 4.5" xyaxes="1 0 0 0 0.32 0.95"/>
    <camera name="corner_cam" pos="12 -12 6" xyaxes="0.7 0.71 0 -0.34 0.34 0.88"/>
    <!-- Follows the robot, which is the useful view when watching a patrol. -->
    <camera name="chase" mode="trackcom" pos="-3.5 -3.5 2.4" xyaxes="0.71 -0.71 0 0.3 0.3 0.9"/>

    <!-- ========================== THE BUILDING ==========================
         14 x 10 m footprint, 7 m tall, centred at the origin. Walls are 0.3 m thick.
         Each face gets a different treatment so the robot can tell them apart by sight.
    -->
    <!-- South face, with the entrance. This is the side the stairs are on. -->
    <geom name="bldg_s_l" class="c_wall" size="4.6 0.15 3.5" pos="-2.4 -5.0 3.5"/>
    <geom name="bldg_s_r" class="c_wall" size="4.6 0.15 3.5" pos="2.4 -5.0 3.5"/>
    <geom name="bldg_s_top" class="c_wall" size="2.2 0.15 1.15" pos="0 -5.0 5.85"/>
    <!-- Entrance: a bright recess, the one visually unmistakable feature on the building. -->
    <geom name="entrance_g" class="c_prop" size="2.2 0.10 2.35" pos="0 -4.92 2.35"
          material="entrance"/>
    <geom name="entrance_lintel" class="c_prop" size="2.5 0.22 0.16" pos="0 -5.05 4.85"
          material="roof"/>

    <geom name="bldg_n" class="c_wall" size="7.0 0.15 3.5" pos="0 5.0 3.5"/>
    <geom name="bldg_w" class="c_wall" size="0.15 5.0 3.5" pos="-7.0 0 3.5"/>
    <geom name="bldg_e" class="c_wall" size="0.15 5.0 3.5" pos="7.0 0 3.5"
          material="wall_east"/>
    <geom name="bldg_roof" class="c_wall" size="7.2 5.2 0.18" pos="0 0 7.1" material="roof"/>

    <!-- Windows: bands of glass on three faces, at two levels. Purely visual, but they are
         what make one wall distinguishable from another in a camera image. -->
    <geom name="win_n1" class="c_prop" size="5.4 0.06 0.75" pos="0 4.88 2.6" material="glass"/>
    <geom name="win_n2" class="c_prop" size="5.4 0.06 0.75" pos="0 4.88 5.2" material="glass"/>
    <geom name="win_w1" class="c_prop" size="0.06 3.6 0.75" pos="-6.88 0 2.6" material="glass"/>
    <geom name="win_w2" class="c_prop" size="0.06 3.6 0.75" pos="-6.88 0 5.2" material="glass"/>
    <geom name="win_e1" class="c_prop" size="0.06 3.6 0.75" pos="6.88 0 2.6" material="glass"/>
    <geom name="win_e2" class="c_prop" size="0.06 3.6 0.75" pos="6.88 0 5.2" material="glass"/>
    <geom name="win_s1" class="c_prop" size="1.8 0.06 0.7" pos="-4.6 -4.88 5.2" material="glass"/>
    <geom name="win_s2" class="c_prop" size="1.8 0.06 0.7" pos="4.6 -4.88 5.2" material="glass"/>

    <!-- ============================= STEPS =============================
         Three 0.16 m rises up to a landing at the entrance. Each tread is 0.40 m deep, which
         is a little more than the robot's 0.42 m stance -- so it can stand with a front foot
         on one tread and a hind foot on the one below, which is how a quadruped climbs.
    -->
    <geom name="step_1" class="c_step" size="2.6 0.20 0.08" pos="0 -6.30 0.08"/>
    <geom name="step_2" class="c_step" size="2.6 0.20 0.16" pos="0 -5.90 0.16"/>
    <geom name="step_3" class="c_step" size="2.6 0.20 0.24" pos="0 -5.50 0.24"/>
    <geom name="landing" class="c_step" size="2.6 0.30 0.24" pos="0 -5.05 0.24"/>
    <!-- A painted edge on the top step: the visual cue a stair nosing gives a person. -->
    <geom name="step_edge" class="c_prop" size="2.6 0.04 0.02" pos="0 -6.49 0.17"
          material="marker"/>

    <!-- =========================== PLANTING ===========================
         Trees are a trunk plus a canopy sphere, placed so there are walkable gaps between
         them. The canopies are ABOVE the robot's head (centre 2.6 m, so the underside is
         about 1.4 m) -- they show up in the camera without blocking the route, which is what
         makes them useful as landmarks rather than as obstacles.
    -->
    <geom name="tree_1_t" type="cylinder" size="0.20 1.30" pos="-9.5 6.5 1.30"
          material="trunk_mat" group="1"/>
    <geom name="tree_1_c" type="ellipsoid" size="1.60 1.60 1.30" pos="-9.5 6.5 3.60"
          material="leaf_mat" group="1"/>
    <geom name="tree_2_t" type="cylinder" size="0.20 1.30" pos="-3.5 8.2 1.30"
          material="trunk_mat" group="1"/>
    <geom name="tree_2_c" type="ellipsoid" size="1.70 1.70 1.40" pos="-3.5 8.2 3.70"
          material="leaf_mat" group="1"/>
    <geom name="tree_3_t" type="cylinder" size="0.22 1.40" pos="3.8 8.4 1.40"
          material="trunk_mat" group="1"/>
    <geom name="tree_3_c" type="ellipsoid" size="1.80 1.80 1.45" pos="3.8 8.4 3.90"
          material="leaf_mat" group="1"/>
    <geom name="tree_4_t" type="cylinder" size="0.20 1.30" pos="9.8 6.0 1.30"
          material="trunk_mat" group="1"/>
    <geom name="tree_4_c" type="ellipsoid" size="1.60 1.60 1.30" pos="9.8 6.0 3.60"
          material="leaf_mat" group="1"/>
    <geom name="tree_5_t" type="cylinder" size="0.20 1.25" pos="10.5 -7.5 1.25"
          material="trunk_mat" group="1"/>
    <geom name="tree_5_c" type="ellipsoid" size="1.55 1.55 1.25" pos="10.5 -7.5 3.45"
          material="leaf_mat" group="1"/>
    <geom name="tree_6_t" type="cylinder" size="0.20 1.25" pos="-10.2 -7.2 1.25"
          material="trunk_mat" group="1"/>
    <geom name="tree_6_c" type="ellipsoid" size="1.55 1.55 1.25" pos="-10.2 -7.2 3.45"
          material="leaf_mat" group="1"/>

    <!-- Hedges: low, solid, and unlike the trees they DO block the route. They narrow the
         corridor along the north side, so the patrol has somewhere it has to squeeze. -->
    <geom name="hedge_n1" class="c_prop" size="3.2 0.45 0.55" pos="-6.5 10.0 0.55"
          material="hedge_mat"/>
    <geom name="hedge_n2" class="c_prop" size="3.2 0.45 0.55" pos="6.5 10.0 0.55"
          material="hedge_mat"/>
    <geom name="hedge_w" class="c_prop" size="0.45 3.0 0.55" pos="-12.5 0 0.55"
          material="hedge_mat"/>
    <geom name="hedge_e" class="c_prop" size="0.45 3.0 0.55" pos="12.5 0 0.55"
          material="hedge_mat"/>

    <!-- Bollards along the south approach: small, bright obstacles with gaps to walk between.
         The gaps are 1.8 m, comfortably wider than the robot but narrow enough to matter. -->
    <geom name="bollard_1" type="cylinder" size="0.10 0.45" pos="-3.6 -9.0 0.45"
          material="bollard" group="1"/>
    <geom name="bollard_2" type="cylinder" size="0.10 0.45" pos="-1.8 -9.0 0.45"
          material="bollard" group="1"/>
    <geom name="bollard_3" type="cylinder" size="0.10 0.45" pos="1.8 -9.0 0.45"
          material="bollard" group="1"/>
    <geom name="bollard_4" type="cylinder" size="0.10 0.45" pos="3.6 -9.0 0.45"
          material="bollard" group="1"/>

    <!-- ========================= PATROL MARKERS =========================
         The four corners of the loop, as sites rather than geoms: they mark positions without
         being able to obstruct anything. brain/patrol.py reads these, so the route is defined
         by the scene rather than hard-coded in Python -- change the building and the patrol
         follows it.
    -->
    <site name="waypoint_1" pos="11.0 -8.5 0.4" size="0.28" rgba="0.95 0.8 0.1 0.45"/>
    <site name="waypoint_2" pos="11.0 8.5 0.4" size="0.28" rgba="0.95 0.8 0.1 0.45"/>
    <site name="waypoint_3" pos="-11.0 8.5 0.4" size="0.28" rgba="0.95 0.8 0.1 0.45"/>
    <site name="waypoint_4" pos="-11.0 -8.5 0.4" size="0.28" rgba="0.95 0.8 0.1 0.45"/>
    <site name="entrance_site" pos="0 -6.9 0.4" size="0.30" rgba="0.95 0.45 0.15 0.45"/>
  </worldbody>

  <keyframe>
    <!--
      qpos = quadruped only (19): the campus adds no joints of its own.

      "start" puts the robot on the paving south of the building, facing north (+y) toward the
      entrance. Its forward axis is +x, so the quaternion (0.7071,0,0,0.7071) is +90 degrees
      about z, mapping +x onto +y -- the same convention as every other scene here.
    -->
    <key name="start"
         qpos="0 -10.5 0.3646   0.7071 0 0 0.7071
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24"/>
    <!-- "corner" starts at the south-east corner, which is where a loop patrol begins. -->
    <key name="corner"
         qpos="11.0 -8.5 0.3646   1 0 0 0
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24"/>
    <!-- "steps" starts right at the foot of the stairs, for climbing tests. -->
    <key name="steps"
         qpos="0 -7.4 0.3646   0.7071 0 0 0.7071
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24
               0 -0.62 1.24"/>
  </keyframe>
</mujoco>
